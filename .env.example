# Banco/Auth (Supabase)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Somente backend/cron. Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=...

# Vercel AI Gateway usa VERCEL_OIDC_TOKEN automaticamente em deploys compatíveis.
# Opcional: uma chave do AI Gateway também pode ser usada.
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-5.6-sol

# Protege o endpoint de cron.
CRON_SECRET=troque-por-um-segredo-longo
